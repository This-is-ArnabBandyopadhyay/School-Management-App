<!-- res/layout/item_admin_leave.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/item_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:elevation="2dp">

    <TextView android:id="@+id/tvName"
        android:text="Student Name"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginBottom="4dp"
        android:layout_width="wrap_content"
        
        android:layout_height="wrap_content" />

<TextView
    android:id="@+id/tvRoll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Roll No" />

<TextView
    android:id="@+id/tvClassSec"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Class and Section" />
    
    <TextView android:id="@+id/tvDates"
        android:text="From → To"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView android:id="@+id/tvReason"
        android:text="Reason"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView android:id="@+id/tvAppliedAt"
        android:text="Applied At"
        android:textSize="12sp"
        android:textColor="#888888"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <Button android:id="@+id/btnApprove"
            android:text="Approve"
            android:layout_marginEnd="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Button android:id="@+id/btnReject"
            android:text="Reject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
