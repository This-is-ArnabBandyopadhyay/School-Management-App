<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#f5f5f5"
    tools:context=".activities.SubmitQueryActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/black"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:title="Submit Query">
    </androidx.appcompat.widget.Toolbar>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- NEW: Spinner for selecting a child (visible only for parents) -->
        <TextView
            android:id="@+id/selectChildLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Query related to:"
            android:textColor="#333"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"
            android:visibility="gone"/> <!-- Initially gone -->

        <Spinner
            android:id="@+id/childSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edittext_background"
            android:padding="8dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone"/> <!-- Initially gone -->
        <!-- END NEW -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your Query"
            android:textColor="#333"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/query_input"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="Enter your query here"
            android:background="@drawable/edittext_background"
            android:padding="12dp"
            android:textSize="16sp"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/submit_query_btn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Submit Query"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:background="@android:color/black"
            android:textColor="@android:color/white"
            android:layout_marginTop="16dp"/>
    </LinearLayout>
</LinearLayout>