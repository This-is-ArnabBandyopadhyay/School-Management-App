<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="?android:attr/selectableItemBackground">

    <!-- Heading with improved styling -->
    

    <!-- Attendance entry card with better visual hierarchy -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@android:color/white"
        android:padding="16dp"
        android:layout_marginBottom="8dp"
        android:elevation="4dp"
        android:outlineProvider="bounds">

        <!-- Date text with improved spacing -->
        <TextView
            android:id="@+id/attendance_date"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="12 July 2023"
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:paddingEnd="8dp"/>

        <!-- Status indicator with better visual treatment -->
        <TextView
            android:id="@+id/attendance_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Present"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@android:color/holo_green_dark"
            android:background="?android:attr/selectableItemBackground"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"/>
    </LinearLayout>
</LinearLayout>