<ScrollView 
xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical">
    <EditText android:id="@+id/etFrom" android:hint="From date (YYYY-MM-DD)" />
    <EditText android:id="@+id/etTo" android:hint="To date (YYYY-MM-DD)" />
    <EditText android:id="@+id/etReason" android:hint="Reason" android:inputType="textMultiLine" />
    <Button android:id="@+id/btnSubmit" android:text="Submit" />
  </LinearLayout>
</ScrollView>
