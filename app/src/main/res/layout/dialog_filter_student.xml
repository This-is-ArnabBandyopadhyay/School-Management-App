<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/filterName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Name"
            android:inputType="text"
            android:padding="12dp"
            android:textSize="16sp"/>

        <EditText
            android:id="@+id/filterRollNo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Roll Number"
            android:inputType="text"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:textSize="16sp"/>

        <EditText
            android:id="@+id/filterRegNo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Registration Number"
            android:inputType="text"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:textSize="16sp"/>

        <EditText
            android:id="@+id/filterEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:textSize="16sp"/>

        <EditText
            android:id="@+id/filterPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Phone Number"
            android:inputType="phone"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:textSize="16sp"/>

        <EditText
            android:id="@+id/filterAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Address"
            android:inputType="textPostalAddress"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:textSize="16sp"/>

        <EditText
            android:id="@+id/filterAdmissionDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Admission Date (YYYY-MM-DD)"
            android:inputType="date"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:textSize="16sp"/>

        <EditText
            android:id="@+id/filterFatherName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Father's Name"
            android:inputType="text"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:textSize="16sp"/>

        <EditText
            android:id="@+id/filterMotherName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mother's Name"
            android:inputType="text"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:textSize="16sp"/>

        <EditText
            android:id="@+id/filterDob"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Date of Birth (YYYY-MM-DD)"
            android:inputType="date"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:textSize="16sp"/>

        <Button
            android:id="@+id/btnClearFilters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clear Filters"
            android:layout_marginTop="16dp"
            android:backgroundTint="#1d1c1cff"
            android:textColor="@android:color/white"/>
    </LinearLayout>
</ScrollView>