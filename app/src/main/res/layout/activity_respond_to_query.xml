<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#f5f5f5"
    tools:context=".activities.RespondToQueryActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/black" android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:title="Respond to Query"> </androidx.appcompat.widget.Toolbar>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"> <EditText
            android:id="@+id/response_input"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="Enter your response here"
            android:background="@drawable/edittext_bg"
            android:padding="12dp"
            android:textSize="16sp"
            android:gravity="top"
            android:inputType="textMultiLine"/>

        <Button
            android:id="@+id/submit_response_btn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Submit Response"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:background="@drawable/button_bg"
            android:textColor="@android:color/black"
            android:layout_marginTop="16dp"/>
    </LinearLayout>
</LinearLayout>