<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/black"
            android:padding="24dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Parent Dashboard"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:id="@+id/parentWelcomeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome back, Parent!"
                    android:textSize="16sp"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:layout_margin="16dp"
            android:elevation="2dp"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="My Children &amp; School Info"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnViewMyStudents"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="View My Children"
                android:background="?attr/selectableItemBackground"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"
                android:drawableLeft="@android:drawable/ic_menu_week"
                android:drawablePadding="8dp"
                style="@style/Widget.AppCompat.Button.Borderless"/>

            <Button
                android:id="@+id/parentViewNoticesButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="View School Notices"
                android:background="?attr/selectableItemBackground"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"
                android:drawableLeft="@android:drawable/ic_menu_view"
                android:drawablePadding="8dp"
                style="@style/Widget.AppCompat.Button.Borderless"/>

            <Button
                android:id="@+id/parentBtnViewHolidays"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="View Academic Holidays"
                android:background="?attr/selectableItemBackground"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:drawableLeft="@android:drawable/ic_menu_day"
                android:drawablePadding="8dp"
                style="@style/Widget.AppCompat.Button.Borderless"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Support &amp; Account"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/parentBtnSubmitQuery"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Submit New Query"
                android:background="?attr/selectableItemBackground"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"
                android:drawableLeft="@android:drawable/ic_menu_edit"
                android:drawablePadding="8dp"
                style="@style/Widget.AppCompat.Button.Borderless"/>

            <Button
                android:id="@+id/parentBtnViewPendingQueries"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="View My Pending Queries"
                android:background="?attr/selectableItemBackground"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"
                android:drawableLeft="@android:drawable/ic_menu_recent_history"
                android:drawablePadding="8dp"
                style="@style/Widget.AppCompat.Button.Borderless"/>

            <Button
                android:id="@+id/parentBtnViewRespondedQueries"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="View My Responded Queries"
                android:background="?attr/selectableItemBackground"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"
                android:drawableLeft="@android:drawable/ic_menu_info_details"
                android:drawablePadding="8dp"
                style="@style/Widget.AppCompat.Button.Borderless"/>

            <Button
                android:id="@+id/parentBtnMyProfile"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="My Profile Details"
                android:background="?attr/selectableItemBackground"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:drawableLeft="@android:drawable/ic_menu_myplaces"
                android:drawablePadding="8dp"
                style="@style/Widget.AppCompat.Button.Borderless"/>
        </LinearLayout>

        <Button
            android:id="@+id/parentBtnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Logout"
            android:layout_margin="16dp"
            android:backgroundTint="@android:color/black"
            android:textColor="@android:color/white"
            android:padding="16dp"
            android:textSize="16sp"
            android:textStyle="bold"
            style="@style/Widget.AppCompat.Button.Colored"/>
    </LinearLayout>
</ScrollView>