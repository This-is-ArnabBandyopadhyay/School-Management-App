<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackgroundFloating"
    android:padding="16dp">

    <!-- Header -->
    <TextView
        android:id="@+id/textViewSelectedClass"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sections for Class 10"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="16dp"
        android:fontFamily="sans-serif-medium"/>

    <!-- Action Buttons Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:background="?android:attr/colorBackground"
        android:elevation="2dp"
        android:padding="8dp"
        android:layout_marginBottom="16dp">

        <Button
    android:id="@+id/btnSearchSection"
    android:layout_width="wrap_content"
    android:layout_height="34dp"
    android:text="Search"
    android:textColor="?android:attr/textColorSecondary"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:textAllCaps="false"
    android:textSize="14sp"
    style="@style/Widget.AppCompat.Button.Borderless"
    android:drawableStart="@android:drawable/ic_menu_search"
    android:drawablePadding="4dp"/>

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="?android:attr/colorControlHighlight"
            android:layout_marginHorizontal="8dp"/>

        <Button
            android:id="@+id/btnAddSection"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Add Section"
            android:textColor="@android:color/white"
            android:backgroundTint="?android:attr/colorPrimary"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textAllCaps="false"
            android:textSize="14sp"
            style="@style/Widget.AppCompat.Button.Colored"/>
    </LinearLayout>

    <!-- Sections List Card -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewSections"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="8dp"
        android:background="?android:attr/colorBackground"
        android:elevation="2dp"/>

    <!-- Empty State -->
    <TextView
        android:id="@+id/textNoSectionsFound"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No Sections Found"
        android:textAlignment="center"
        android:textColor="?android:attr/textColorHint"
        android:textSize="16sp"
        android:layout_marginTop="32dp"
        android:visibility="gone"
        android:fontFamily="sans-serif"/>
</LinearLayout>