<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="?attr/colorPrimary"
            android:padding="24dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Admin Dashboard"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_marginBottom="8dp"
                android:gravity="center"/>

 <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:id="@+id/welcomeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Administrator"
                    android:textSize="16sp"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"/>
        </LinearLayout>
        </LinearLayout>

        <!-- Quick Actions Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:layout_margin="16dp"
            android:elevation="2dp"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Quick Actions"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/issueNoticeButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Issue New Notice"
                android:background="?attr/selectableItemBackground"
                android:textColor="?attr/colorPrimary"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"
                android:drawableLeft="@android:drawable/ic_menu_agenda"
                android:drawablePadding="8dp"
                style="@style/Widget.AppCompat.Button.Borderless"/>

            <Button
                android:id="@+id/btn_view_all_queries"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="View All Queries"
                android:background="?attr/selectableItemBackground"
                android:textColor="?attr/colorPrimary"
                android:textSize="16sp"
                android:drawableLeft="@android:drawable/ic_menu_help"
                android:drawablePadding="8dp"
                style="@style/Widget.AppCompat.Button.Borderless"/>
        </LinearLayout>

        <!-- Management Tools Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Management Tools"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btn_manage_leaves"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Manage Leave Applications"
                android:background="?attr/selectableItemBackground"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"
                android:drawableLeft="@android:drawable/ic_menu_my_calendar"
                android:drawablePadding="8dp"
                style="@style/Widget.AppCompat.Button.Borderless"/>

            <Button
                android:id="@+id/btn_manage_classes"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Manage Classes &amp; Sections"
                android:background="?attr/selectableItemBackground"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"
                android:drawableLeft="@android:drawable/ic_menu_sort_by_size"
                android:drawablePadding="8dp"
                style="@style/Widget.AppCompat.Button.Borderless"/>

                <Button
            android:id="@+id/btn_manage_groups"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Manage Student Groups"
            android:background="?attr/selectableItemBackground"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"
            android:drawableLeft="@android:drawable/ic_menu_agenda"
            android:drawablePadding="8dp"
            style="@style/Widget.AppCompat.Button.Borderless"/>

            <Button
                android:id="@+id/btnManageHolidays"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Manage Holidays"
                android:background="?attr/selectableItemBackground"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:drawableLeft="@android:drawable/ic_menu_day"
                android:drawablePadding="8dp"
                style="@style/Widget.AppCompat.Button.Borderless"/>
        </LinearLayout>

        <!-- Add a new card for Group Management -->
    

       
           

        

        <!-- Admin Settings Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Admin Settings"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btn_manage_admins"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Manage Admin Accounts"
                android:background="?attr/selectableItemBackground"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"
                android:drawableLeft="@android:drawable/ic_menu_manage"
                android:drawablePadding="8dp"
                style="@style/Widget.AppCompat.Button.Borderless"/>

            <Button
                android:id="@+id/btnViewHolidays"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="View Upcoming Holidays"
                android:background="?attr/selectableItemBackground"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"
                android:drawableLeft="@android:drawable/ic_menu_today"
                android:drawablePadding="8dp"
                style="@style/Widget.AppCompat.Button.Borderless"/>

            <Button
                android:id="@+id/btnViewProfile"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="My Profile"
                android:background="?attr/selectableItemBackground"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:drawableLeft="@android:drawable/ic_menu_myplaces"
                android:drawablePadding="8dp"
                style="@style/Widget.AppCompat.Button.Borderless"/>
        </LinearLayout>

        <!-- Logout Button -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Logout"
            android:layout_margin="16dp"
            android:backgroundTint="?attr/colorPrimary"
            android:textColor="@android:color/white"
            android:padding="16dp"
            android:textSize="16sp"
            android:textStyle="bold"
            style="@style/Widget.AppCompat.Button.Colored"/>
    </LinearLayout>
</ScrollView>