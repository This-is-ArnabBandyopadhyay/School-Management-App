<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.stuadminlogin">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Stuadminlogin"
        tools:targetApi="31">

        <!-- ✅ MAIN Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Student Login Screen -->
        <activity
            android:name=".StudentLoginActivity"
            android:exported="false" />

        <!-- Admin Login Screen -->
        <activity
            android:name=".AdminLoginActivity"
            android:exported="false" />

        <!-- Admin Dashboard -->
        <activity
            android:name=".AdminDashboard"
            android:exported="false" />

        <activity
            android:name=".SendNoticeActivity"
            android:exported="false"/>
        <activity android:name=".ReadNotices"
            android:exported="false" />
        <activity android:name=".StudentDashboard"
            android:exported="false" />



    </application>
</manifest>
